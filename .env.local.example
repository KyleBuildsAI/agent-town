# AgentTown LLM Configuration
# Copy this to .env.local and fill in your values.
# Only ONE provider section needs to be configured.

# ============================================================
# PROVIDER SELECTION (optional — auto-detected from env vars)
# Set explicitly to override auto-detection order.
# Values: openai | together | anthropic | litellm | ollama | custom
# ============================================================
# LLM_PROVIDER=anthropic

# ============================================================
# OPTION 1: Ollama (local, free) — DEFAULT
# No API key needed. Just run Ollama locally.
# ============================================================
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3
# OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# ============================================================
# OPTION 2: Anthropic (Claude) — direct API
# Best for high-quality conversations. Embeddings use Ollama.
# ============================================================
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_URL=https://api.anthropic.com

# ============================================================
# OPTION 3: LiteLLM Proxy — routes to multiple backends
# Point at your LiteLLM instance. Supports tiered routing:
# configure cheap models for simple tasks and Claude for
# complex conversations in your LiteLLM config.
# ============================================================
# LITELLM_API_URL=http://127.0.0.1:4000
# LITELLM_API_KEY=sk-...
# LITELLM_CHAT_MODEL=gpt-4o-mini
# LITELLM_EMBEDDING_MODEL=text-embedding-ada-002

# ============================================================
# OPTION 4: OpenAI — direct API
# Change EMBEDDING_DIMENSION to 1536 in convex/util/llm.ts
# ============================================================
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# ============================================================
# OPTION 5: Together.ai
# Change EMBEDDING_DIMENSION to 768 in convex/util/llm.ts
# ============================================================
# TOGETHER_API_KEY=...
# TOGETHER_CHAT_MODEL=meta-llama/Llama-3-8b-chat-hf
# TOGETHER_EMBEDDING_MODEL=togethercomputer/m2-bert-80M-8k-retrieval

# ============================================================
# OPTION 6: Custom (any OpenAI-compatible API)
# ============================================================
# LLM_API_URL=http://your-api:8080
# LLM_API_KEY=...
# LLM_MODEL=your-model-name
# LLM_EMBEDDING_MODEL=your-embedding-model

# ============================================================
# Convex deployment (set by `npx convex dev`)
# ============================================================
# CONVEX_DEPLOYMENT=dev:your-deployment
# VITE_CONVEX_URL=https://your-deployment.convex.cloud

# ============================================================
# Clerk authentication (optional)
# ============================================================
# VITE_CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...
